# 复制成 .env 后按需修改；install.sh 会自动生成 PROXY_SECRET
# 注意：这个文件只放在 VPS 上，不要提交进仓库

# ---------- 万能反代 ----------
# 路径口令，越长越好；不带口令的请求一律 403
PROXY_SECRET=change-me-to-a-long-random-string
# 对外端口（记得在防火墙/安全组放行）
PROXY_PORT=8787
# 只允许这些域名经过反代，逗号分隔；留空=允许所有（靠 SECRET 保护）
PROXY_ALLOW_HOSTS=
# 单次上游请求超时（毫秒）
PROXY_TIMEOUT_MS=20000

# ---------- danmu_api 本体（仅在 --profile app 时生效）----------
DANMU_PORT=9321
DANMU_TOKEN=87654321
DANMU_ADMIN_TOKEN=
SOURCE_ORDER=dandan,bilibili,animeko,bahamut,aiyifan,maiduidui,360,renren,hanjutv
MERGE_SOURCE_PAIRS=dandan&animeko&bahamut
SEARCH_CACHE_MINUTES=3
# 留空则由 install.sh 自动填成 @http://proxy:8787/<PROXY_SECRET>
PROXY_URL=
